# 复制为 .env，密钥也可稍后在管理页设置。
ADMIN_PASSWORD=
# 留空会在持久数据目录生成 admin-secret.txt。
LLM_FORMAT=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_VISION=false
TAVILY_API_KEY=
TZ=Asia/Shanghai
# 微信联系人 ID 可在管理页出现后允许；填写此项可预先允许指定联系人。
WECHAT_ALLOWED_PEERS=
# 管理页默认只绑定服务器本机，通过 SSH 隧道或 HTTPS 反向代理访问。
ATRI_BIND=127.0.0.1
ATRI_PORT=3000
COOKIE_SECURE=false
